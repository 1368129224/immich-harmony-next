# ==============================================================================
# Android Relay Tailscale Configuration for scripts/push_tunnel.sh
# 复制本文件为 scripts/.tunnel.env 并填入你实际的安卓 Tailscale IP 即可生效。
# 该文件已被 .gitignore 忽略，不会被提交到 Git。
# ==============================================================================

# 安卓中继机的 Tailscale 虚拟 IP（在安卓端的 Tailscale App 界面查看）
ANDROID_IP="100.80.90.20"

# 中继端口（需与安卓端 pymobiledevice3 remote tunneld 监听端口一致）
TUNNEL_PORT="55553"

# 完整隧道地址（可选，设置后将覆盖 ANDROID_IP 和 TUNNEL_PORT）
# TUNNEL="100.80.90.20:55553"

# 应用 Bundle ID（默认使用 Immich 原生项目的 Bundle ID）
BUNDLE_ID="com.immichz.immichz"

# 默认待安装的 IPA 路径（默认对齐 update_livecontainer_ipa.sh 的输出路径）
IPA_PATH="/mnt/ssd/temp/ipa/Immich-unsigned.ipa"
