# ==============================================================================
# scripts/entry/ios.sh 与 scripts/push_tunnel.sh 的本地配置
# 复制为 scripts/.tunnel.env 后按需修改；该文件已被 .gitignore 忽略，不会提交。
# 变量均可省略，省略时使用脚本内置默认值（P12_PASSWORD 除外）。
# ==============================================================================

# 安卓中继机的 Tailscale IP 与网络 ADB 端口
ANDROID_IP="100.x.y.z"
ADB_PORT="5555"

# 应用 Bundle ID
BUNDLE_ID="com.immichz.immichz"

# IPA 目录（与 update_livecontainer_ipa.sh 输出一致）
IPA_DIR="/mnt/ssd/temp/ipa"

# 直接调用 push_tunnel.sh 时默认推送的 IPA（ios.sh push/deploy 不使用此变量）
# IPA_PATH="/mnt/ssd/temp/ipa/Immich-signed.ipa"

# scripts/cert/*.p12 的导出密码（ios.sh sign / deploy 必需）
P12_PASSWORD="your_p12_password"
